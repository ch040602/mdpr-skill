{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdpresent.dev/schemas/mdpr-change-request.schema.json",
  "title": "MDPR Change Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "stage", "createdBy", "source", "changes", "requiresApproval"],
  "properties": {
    "schemaVersion": { "const": "mdpr-change-request-v1" },
    "id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["proposed", "reviewed", "approved", "applied", "rejected"] },
    "createdBy": { "enum": ["mdpr-skill", "mdpr-ppt", "user"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256"],
      "properties": {
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "selectionRef": { "type": "string" }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["agent-hint", "edit-intent", "mdpr-policy-suggestion", "user-override-candidate", "pack-candidate"] }
        }
      }
    },
    "requiresApproval": { "type": "boolean" },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "enum": ["approved", "applied"] } } },
      "then": { "properties": { "approval": { "type": "object" } } }
    }
  ]
}
