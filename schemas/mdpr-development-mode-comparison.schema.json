{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdpresent.dev/schemas/mdpr-development-mode-comparison.schema.json",
  "title": "MDPR Development Mode Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedBy",
    "sourceReviewedDate",
    "comparisonScope",
    "evidenceArtifacts",
    "modes",
    "summary"
  ],
  "properties": {
    "$schema": {
      "const": "https://mdpresent.dev/schemas/mdpr-development-mode-comparison.schema.json"
    },
    "schemaVersion": {
      "const": "mdpr-development-mode-comparison-v1"
    },
    "generatedBy": {
      "const": "mdpr-skill"
    },
    "sourceReviewedDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "comparisonScope": {
      "type": "string",
      "minLength": 1
    },
    "evidenceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/mode"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readmeSignals",
        "recommendation"
      ],
      "properties": {
        "readmeSignals": {
          "$ref": "#/$defs/stringArray"
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "before",
        "after",
        "mdprConsumable",
        "deterministicReplayable",
        "actualMdprCorpus",
        "evidence"
      ],
      "properties": {
        "id": {
          "enum": [
            "simple-codex-skill",
            "mdpr-only",
            "mdpr-skill-plus-mdpr"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "mdprConsumable": {
          "type": "boolean"
        },
        "deterministicReplayable": {
          "type": "boolean"
        },
        "actualMdprCorpus": {
          "$ref": "#/$defs/metrics"
        },
        "guidedHintAcceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "accepted",
            "rejected",
            "ignoredBecauseStale",
            "forbiddenFieldCount"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "accepted": {
              "type": "integer",
              "minimum": 0
            },
            "rejected": {
              "type": "integer",
              "minimum": 0
            },
            "ignoredBecauseStale": {
              "type": "integer",
              "minimum": 0
            },
            "forbiddenFieldCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slides",
        "shapes",
        "textFrames",
        "tables",
        "charts"
      ],
      "properties": {
        "slides": {
          "type": "integer",
          "minimum": 0
        },
        "shapes": {
          "type": "integer",
          "minimum": 0
        },
        "textFrames": {
          "type": "integer",
          "minimum": 0
        },
        "pictures": {
          "type": "integer",
          "minimum": 0
        },
        "tables": {
          "type": "integer",
          "minimum": 0
        },
        "charts": {
          "type": "integer",
          "minimum": 0
        },
        "minFontSizePt": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
