{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdpresent.dev/schemas/mdpr-format-capabilities.schema.json",
  "title": "MDPR Skill Format Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedBy",
    "comparisonTarget",
    "mdprSkill",
    "coverage",
    "advantageClaim"
  ],
  "properties": {
    "$schema": {
      "const": "https://mdpresent.dev/schemas/mdpr-format-capabilities.schema.json"
    },
    "schemaVersion": {
      "const": "mdpr-skill-format-capabilities-v1"
    },
    "generatedBy": {
      "const": "mdpr-skill"
    },
    "comparisonTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "focus",
        "sourceReviewedDate",
        "sourceReviewTimezone",
        "sourceReviewScope",
        "publicInputModes",
        "publicReferenceInputs",
        "publicWorkflowStages",
        "publicOutputFormats",
        "publicAssuranceArtifacts",
        "sourceRefs",
        "sourceEvidence"
      ],
      "properties": {
        "name": {
          "const": "FigureLabs"
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "sourceReviewedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sourceReviewTimezone": {
          "type": "string",
          "minLength": 1
        },
        "sourceReviewScope": {
          "type": "string",
          "minLength": 1
        },
        "publicInputModes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "publicReferenceInputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "publicWorkflowStages": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "publicOutputFormats": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "publicAssuranceArtifacts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceEvidenceItem"
          }
        }
      }
    },
    "mdprSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus",
        "inputFormats",
        "outputFormats",
        "comparisonReportFormats",
        "artifactContracts",
        "editableOutputs",
        "deterministicRuntime",
        "workflowStages",
        "assuranceArtifacts",
        "figureLabsGapClosures",
        "completenessSignals",
        "boundaries"
      ],
      "properties": {
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "inputFormats": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "outputFormats": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "comparisonReportFormats": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "artifactContracts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "editableOutputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "deterministicRuntime": {
          "const": "MDPR"
        },
        "workflowStages": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "assuranceArtifacts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "figureLabsGapClosures": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "completenessSignals": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "boundaries": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figureLabs",
        "mdprSkill"
      ],
      "properties": {
        "figureLabs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publicFormatFamilies",
            "publiclyDocumentedOutputFormats",
            "publicWorkflowStages",
            "publicAssuranceArtifacts",
            "publicEvidenceClaims"
          ],
          "properties": {
            "publicFormatFamilies": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "publiclyDocumentedOutputFormats": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "publicWorkflowStages": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "publicAssuranceArtifacts": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "publicEvidenceClaims": {
              "$ref": "#/$defs/nonNegativeInteger"
            }
          }
        },
        "mdprSkill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formatFamilies",
            "inputFormatFamilies",
            "outputFormatFamilies",
            "comparisonReportFormats",
            "artifactContracts",
            "workflowCompletenessSignals",
            "assuranceArtifacts"
          ],
          "properties": {
            "formatFamilies": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "inputFormatFamilies": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "outputFormatFamilies": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "comparisonReportFormats": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "artifactContracts": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "workflowCompletenessSignals": {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            "assuranceArtifacts": {
              "$ref": "#/$defs/nonNegativeInteger"
            }
          }
        }
      }
    },
    "advantageClaim": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "sourceEvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "claim",
        "sourceRefs"
      ],
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
