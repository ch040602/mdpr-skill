{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdpresent.dev/schemas/agent-hint.schema.json",
  "title": "MDPR Agent Hint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intentCandidate": { "type": "string" },
    "groupCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "elementIds": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["elementIds", "role", "confidence"]
      }
    },
    "importanceCandidates": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["recipeId"] },
      { "required": ["variantId"] },
      { "required": ["box"] },
      { "required": ["x"] },
      { "required": ["y"] },
      { "required": ["w"] },
      { "required": ["h"] },
      { "required": ["color"] },
      { "required": ["effect"] }
    ]
  }
}
