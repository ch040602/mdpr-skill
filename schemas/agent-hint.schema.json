{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdpresent.dev/schemas/agent-hint.schema.json",
  "title": "MDPR Agent Hint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slideId": { "type": "string" },
    "intentCandidate": { "type": "string" },
    "groupCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "elementIds": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["elementIds", "role", "confidence"]
      }
    },
    "importanceCandidates": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 }
    },
    "iconKeywordCandidates": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]*$"
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["recipeId"] },
      { "required": ["variantId"] },
      { "required": ["box"] },
      { "required": ["x"] },
      { "required": ["y"] },
      { "required": ["w"] },
      { "required": ["h"] },
      { "required": ["color"] },
      { "required": ["fontSize"] },
      { "required": ["fontFamily"] },
      { "required": ["typography"] },
      { "required": ["zOrder"] },
      { "required": ["radius"] },
      { "required": ["shadow"] },
      { "required": ["effect"] },
      { "required": ["arrow"] },
      { "required": ["component"] },
      { "required": ["style"] },
      { "required": ["iconAsset"] },
      { "required": ["iconPath"] },
      { "required": ["iconName"] }
    ]
  }
}
